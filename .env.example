# Copy to .env and fill in. .env is git-ignored: never commit real values.

# Answering and judging (Step 3)
ANTHROPIC_API_KEY=

# Postgres with pgvector in Docker (compose.yaml, D-041)
# Use 127.0.0.1, not localhost: the port is IPv4-only, and localhost waits on IPv6 first.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://srag:<password>@127.0.0.1:5432/srag

# Optional: set this to run the database tests against a separate database
SRAG_TEST_DATABASE_URL=postgresql://srag:<password>@127.0.0.1:5432/srag_test
